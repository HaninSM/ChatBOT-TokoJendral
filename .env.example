# Telegram Bot Configuration
# Dapatkan BOT_TOKEN dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Dapatkan User ID / Chat ID Anda dengan mengirim chat ke @userinfobot di Telegram
TELEGRAM_OWNER_ID=your_telegram_user_id_here

# Google Gemini API Key
# Dapatkan dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini (Default: gemini-2.5-flash atau gemini-flash-latest)
GEMINI_MODEL=gemini-2.5-flash

# Path ke Database Invo POS SQLite
POS_DB_PATH=d:/POS/database/pos.db
